@model DuendeIdentityServer.ViewModels.ErrorViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Error - Duende</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h3 class="mb-4">Unable to complete login</h3>
                        @if (!string.IsNullOrWhiteSpace(Model.Error))
                        {
                            <p class="text-danger">Error: <strong>@Model.Error</strong></p>
                        }
                        else
                        {
                            <p>The error details are unavailable or have expired.</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ErrorDescription))
                        {
                            <p>@Model.ErrorDescription</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.RequestId))
                        {
                            <p class="text-muted">Request ID: <code>@Model.RequestId</code></p>
                        }
                        <p>Return to the webshop and try logging in again. If the problem continues, contact the administrator with the error and request ID above.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@model Webshop.MVC.ViewModels.OrderCreateViewModel

@{
    ViewData["Title"] = "Create New Order";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 bg-white shadow-sm rounded">
            <h2 class="text-center mb-4 text-success">Register New Order</h2>
            <form asp-action="Create">
                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label asp-for="Street" class="form-label">Street</label>
                        <input asp-for="Street" class="form-control" placeholder="e.g. Main Street">
                        <span asp-validation-for="Street" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="HouseNumber" class="form-label">House Number</label>
                        <input asp-for="HouseNumber" class="form-control" placeholder="e.g. 12A">
                        <span asp-validation-for="HouseNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="PostalCode" class="form-label">Postal Code</label>
                        <input asp-for="PostalCode" class="form-control" placeholder="e.g. 1000">
                        <span asp-validation-for="PostalCode" class="text-danger"></span>
                    </div>
                    <div class="col-md-8 mb-3">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="form-control" placeholder="e.g. Brussels">
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="Country" class="form-label">Country</label>
                    <input asp-for="Country" class="form-control" placeholder="e.g. Belgium">
                    <span asp-validation-for="Country" class="text-danger"></span>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success">Save Order</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@model Webshop.MVC.ViewModels.OrderDetailViewModel

@{
    ViewData["Title"] = "Confirm Deletion";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 text-center bg-white p-5 shadow rounded border-top border-danger border-4">
            <h1 class="text-danger mb-4"><i class="bi bi-exclamation-triangle"></i></h1>
            <h3>Are you sure?</h3>
            <p class="text-muted">You are about to delete <strong class="text-dark">Order #@Model.OrderId</strong>. This action cannot be undone.</p>
            <div class="mt-4">
                <form asp-action="Delete">
                    <input type="hidden" name="id" value="@Model.OrderId" />
                    <button type="submit" class="btn btn-danger px-5 mb-2">Yes, Delete It</button>
                    <a asp-action="Index" class="btn btn-secondary px-5 mb-2">No, Keep It</a>
                </form>
            </div>
        </div>
    </div>
</div>
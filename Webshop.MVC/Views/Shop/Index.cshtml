@{
}
@model IEnumerable<Webshop.MVC.ViewModels.ProductListViewModel>

@{
	ViewData["Title"] = "Outdoor Adventure Catalog";
}

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h2>Outdoor Adventure Store</h2>
		
	</div>

	@* Category Filter Buttons *@
	<div class="d-flex flex-wrap gap-2 mb-4">
		<a asp-action="Index" asp-route-categoryId=""
		   class="btn @(ViewBag.CurrentCategory == 0 ? "btn-dark" : "btn-outline-dark") rounded-pill px-4 fw-bold">
			All
		</a>

		@foreach (var category in (IEnumerable<Webshop.Domain.Entities.Category>)ViewBag.Categories)
		{
			<a asp-action="Index" asp-route-categoryId="@category.CategoryId"
			   class="btn @(ViewBag.CurrentCategory == category.CategoryId ? "btn-dark" : "btn-outline-dark") rounded-pill px-4">
				@category.Name
			</a>
		}
	</div>
	<div class="row row-cols-1 row-cols-md-3 g-4">
		@foreach (var item in Model)
		{
			<div class="col">
				<div class="card h-100 shadow-sm border-0">
					<img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
					<div class="card-body text-center">
						<span class="badge bg-secondary mb-2">@item.CategoryName</span>
						<h5 class="card-title text-dark">@item.Name</h5>
						<p class="card-text text-muted small">@item.ShortDescription</p>
						<h6 class="text-success fw-bold">€ @item.Price.ToString("F2")</h6>
					</div>
					<div class="card-footer bg-white border-top-0 pb-3">
						<div class="btn-group w-100 shadow-sm" role="group">
							<a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm py-2">
								<i class="bi bi-eye"></i> View
							</a>
							@* NO 'Edit' or 'Delete' buttons! *@
							@* The NEW button: Add to Cart *@
							<a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@item.Id" class="btn btn-success btn-sm py-2">
								<i class="bi bi-cart-plus"></i> Add to Cart
							</a>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
</div>
@{
}
@model Webshop.MVC.ViewModels.ProductDetailViewModel

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-5">
    <div class="row bg-light p-4 rounded shadow-sm">
        <div class="col-md-5">
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Name">
        </div>
        <div class="col-md-7">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
                    <li class="breadcrumb-item active">@Model.CategoryName</li>
                </ol>
            </nav>
            <h1 class="display-5 fw-bold">@Model.Name</h1>
            <p class="text-muted">SKU: <span class="fw-bold">@Model.Sku</span></p>
            <h3 class="text-success mb-4">€ @Model.Price.ToString("F2")</h3>
            <hr>
            <h5>Description</h5>
            <p class="lead">@Model.Description</p>
            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-warning px-4">Edit Product</a>
                <a asp-action="Index" class="btn btn-secondary px-4">Back to List</a>
            </div>
        </div>
    </div>
</div>
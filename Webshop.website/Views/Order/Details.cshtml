@model Webshop.website.ViewModels.OrderDetailViewModel

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-5">
    <div class="row bg-light p-4 rounded shadow-sm">
        <div class="col-md-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Orders</a></li>
                    <li class="breadcrumb-item active">Order #@Model.OrderId</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-5 fw-bold">Order #@Model.OrderId</h1>
                <span class="badge bg-secondary fs-5">@Model.Status</span>
            </div>
            <p class="text-muted">Date: <span class="fw-bold">@Model.OrderDate.ToString("dd MMM yyyy, HH:mm")</span></p>
            <h3 class="text-success mb-4">Total: € @Model.TotalPrice.ToString("F2")</h3>
            <hr>

            <div class="row mt-4">
                <div class="col-md-6">
                    <h5>Customer Information</h5>
                    <p class="lead mb-1"><strong>User ID:</strong> @Model.UserId</p>
                </div>
                <div class="col-md-6">
                    <h5>Delivery Address</h5>
                    <p class="lead">@Model.FullAddress</p>
                </div>
            </div>
            <h4 class="fw-bold mb-3">
                <i class="bi bi-box-seam me-2"></i>Ordered Products
                <span class="badge bg-secondary ms-2 rounded-pill fs-6">@Model.Items.Count items</span>
            </h4>

            @if (Model.Items.Any())
            {
                <div class="d-flex flex-column gap-3 mb-4">
                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between p-3 bg-white border rounded-3 shadow-sm">

                            <div class="d-flex align-items-center mb-3 mb-md-0">
                                <div class="bg-light border rounded-3 d-flex align-items-center justify-content-center p-3 me-3">
                                    <i class="bi bi-bag text-secondary fs-3"></i>
                                </div>
                                <div>
                                    <h5 class="mb-1 fw-bold text-dark">@item.ProductName</h5>
                                    <span class="text-muted">Unit Price: € @item.UnitPrice.ToString("F2")</span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-4 text-center">
                                <div>
                                    <span class="d-block text-muted text-uppercase fw-bold small">Quantity</span>
                                    <span class="fs-4 fw-bold text-dark">@item.Quantity</span>
                                </div>
                                <div style="min-width: 100px;">
                                    <span class="d-block text-muted text-uppercase fw-bold small">Total</span>
                                    <span class="fs-4 fw-bold text-dark">€ @item.TotalPrice.ToString("F2")</span>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 border rounded-3 bg-light shadow-sm">
                    <i class="bi bi-cart-x display-1 text-muted"></i>
                    <p class="mt-3 fs-5 text-muted">This order appears to be empty.</p>
                </div>
            }
            <div class="mt-5">
                <a asp-action="Edit" asp-route-id="@Model.OrderId" class="btn btn-warning px-4">Edit Order</a>
                <a asp-action="Index" class="btn btn-secondary px-4">Back to List</a>
            </div>
        </div>
    </div>
</div>
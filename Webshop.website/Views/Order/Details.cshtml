@model Webshop.website.ViewModels.OrderDetailViewModel

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-5">
    <div class="row bg-light p-4 rounded shadow-sm">
        <div class="col-md-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="breadcrumb-item"><a asp-action="Index">Orders</a></li>
                    }
                    else
                    {
                        <li class="breadcrumb-item"><a asp-action="MyOrders">My Orders</a></li>
                    }
                    <li class="breadcrumb-item active">Order #@Model.OrderId</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-5 fw-bold">Order #@Model.OrderId</h1>
                @{
                    var badgeClass = Model.Status switch
                    {
                        "Pending" => "bg-warning text-dark",
                        "Processing" => "bg-info text-white",
                        "Shipped" => "bg-primary text-white",
                        "Delivered" => "bg-success text-white",
                        "Cancelled" => "bg-danger text-white",
                        _ => "bg-secondary text-white"
                    };
                }
                <span class="badge @badgeClass fs-5">@Model.Status</span>
            </div>
            <p class="text-muted">Date: <span class="fw-bold">@Model.OrderDate.ToString("dd MMM yyyy, HH:mm")</span></p>
            <h3 class="text-success mb-4">Total: @Model.TotalPrice.ToString("C")</h3>
            <hr>

            <div class="row mt-4">
                <div class="col-md-6">
                    <h5>Customer Information</h5>
                    <p class="lead mb-1"><strong>Email:</strong> @Model.UserEmail</p>
                </div>
                <div class="col-md-6">
                    <h5>Delivery Address</h5>
                    <p class="lead">@Model.FullAddress</p>
                </div>
            </div>

            <div class="mt-4">
                <h5>Order Items</h5>
                <div class="table-responsive">
                    <table class="table table-bordered mt-2">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderLines)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                    <td class="text-end">@item.Subtotal.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Total Amount:</th>
                                <th class="text-end text-success">@Model.TotalPrice.ToString("C")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="mt-5">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.OrderId" class="btn btn-warning px-4">Edit Order</a>
                    <a asp-action="Index" class="btn btn-secondary px-4">Back to List</a>
                }
                else
                {
                    <a asp-action="MyOrders" class="btn btn-secondary px-4">Back to My Orders</a>
                }
            </div>
        </div>
    </div>
</div>
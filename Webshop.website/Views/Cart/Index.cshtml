@{
}
@model Webshop.website.ViewModels.CartViewModel

@{
	ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-5">
	<h2 class="mb-4"><i class="bi bi-cart3"></i> Your Shopping Cart</h2>

	@* Check if the cart is empty *@
	@if (!Model.Items.Any())
	{
		<div class="alert alert-light text-center py-5 shadow-sm border">
			<h4 class="alert-heading mb-3">Your cart is currently empty!</h4>
			<p class="text-muted">Looks like you haven't added any camping gear yet.</p>
			<a asp-controller="Shop" asp-action="Index" class="btn btn-success mt-3 px-4 rounded-pill">
				<i class="bi bi-shop"></i> Return to Shop
			</a>
		</div>
	}
	else
	{
		@* Show the list of items in the cart *@
		<div class="card shadow-sm border-0 mb-4">
			<div class="card-body p-0">
				<div class="table-responsive">
					<table class="table table-hover align-middle mb-0">
						<thead class="table-light">
							<tr>
								<th scope="col" class="ps-4">Product</th>
								<th scope="col">Price</th>
								<th scope="col" class="text-center">Quantity</th>
								<th scope="col">Total</th>
								<th scope="col" class="text-end pe-4">Action</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model.Items)
							{
								<tr>
									<td class="ps-4">
										<div class="d-flex align-items-center">
											<img src="@item.ImageUrl" alt="@item.ProductName" class="img-thumbnail me-3 shadow-sm" style="width: 60px; height: 60px; object-fit: cover;">
											<span class="fw-bold text-dark">@item.ProductName</span>
										</div>
									</td>
									<td>€ @item.UnitPrice.ToString("F2")</td>
									<td class="text-center">
										<span class="badge bg-secondary rounded-pill fs-6 px-3">@item.Quantity</span>
									</td>
									<td class="fw-bold text-success">
										€ @((item.UnitPrice * item.Quantity).ToString("F2"))
									</td>
									<td class="text-end pe-4">
										@* Form to remove an item from the cart *@
										<form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
											<input type="hidden" name="productId" value="@item.ProductId" />
											<button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
												<i class="bi bi-trash"></i> Remove
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>

		@* Grand Total and Checkout Button *@
		<div class="row justify-content-end">
			<div class="col-md-5 col-lg-4">
				<div class="card shadow-sm border-0 bg-light">
					<div class="card-body">
						<div class="d-flex justify-content-between mb-3">
							<span class="fs-5 text-muted">Grand Total:</span>
							<span class="fs-4 fw-bold text-success">€ @Model.GrandTotal.ToString("F2")</span>
						</div>

						@if (User.Identity != null && User.Identity.IsAuthenticated)
						{
							<a asp-controller="Checkout" asp-action="Index" class="btn btn-success w-100 py-2 fs-5 fw-bold rounded-pill">
								Proceed to Checkout <i class="bi bi-arrow-right-circle ms-2"></i>
							</a>
						}
						else
						{
							<a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Checkout")" class="btn btn-warning w-100 py-2 fs-5 fw-bold rounded-pill text-dark">
								Login to Checkout <i class="bi bi-box-arrow-in-right ms-2"></i>
							</a>
						}
					</div>
				</div>
			</div>
		</div>
	}
</div>
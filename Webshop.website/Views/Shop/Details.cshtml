@{
}
@model Webshop.website.ViewModels.ProductDetailViewModel

@{
	ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
	<div class="mb-4">
		<a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
			<i class="bi bi-arrow-left"></i> Back to Shop
		</a>
	</div>

	<div class="card shadow-sm border-0">
		<div class="row g-0">
			@* Left Column: Product Image *@
			<div class="col-md-5 d-flex align-items-center bg-light p-4">
				<img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="@Model.Name" style="max-height: 400px; object-fit: contain; width: 100%;">
			</div>

			@* Right Column: Product Details & Cart Button *@
			<div class="col-md-7">
				<div class="card-body p-5">
					<span class="badge bg-secondary mb-2 px-3 py-2 fs-6 rounded-pill">@Model.CategoryName</span>

					<h2 class="card-title fw-bold text-dark mb-3">@Model.Name</h2>

					<h3 class="text-success fw-bold mb-4">€ @Model.Price.ToString("F2")</h3>

					<p class="card-text text-muted mb-5 lh-lg" style="font-size: 1.1rem;">
						@Model.Description
					</p>

					<hr class="mb-4" />

					@* Add to Cart Form *@
					<form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-4">
						<input type="hidden" name="productId" value="@Model.ProductId" />

						<div class="d-grid gap-2 d-md-flex justify-content-md-start">
							<button type="submit" class="btn btn-success btn-lg px-5 rounded-pill fw-bold shadow-sm">
								<i class="bi bi-cart-plus me-2"></i> Add to Cart
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
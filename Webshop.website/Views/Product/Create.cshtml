@{
}
@model Webshop.MVC.ViewModels.ProductCreateViewModel

@{
    ViewData["Title"] = "Add New Camping Gear";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 bg-white shadow-sm rounded">
            <h2 class="text-center mb-4 text-success">Register New Gear</h2>
            <form asp-action="Create">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Product Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Waterproof Tent">
                </div>
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">-- Choose Category --</option>
                    </select>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label">Price (€)</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Sku" class="form-label">SKU / Code</label>
                        <input asp-for="Sku" class="form-control">
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Full Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label">Image URL</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="/images/default.jpg">
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success">Save Product</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
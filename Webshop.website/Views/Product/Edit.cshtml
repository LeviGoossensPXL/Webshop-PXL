@{
}
@model Webshop.website.ViewModels.ProductUpdateViewModel

@{
    ViewData["Title"] = "Update Gear Info";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 bg-white shadow-sm rounded">
            <h2 class="text-center mb-4 text-warning">Edit Product</h2>
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                
                <div class="mb-3 text-center">
                    <label class="d-block">Current Product Image</label>
                    <img src="@Model.CurrentImageUrl" alt="Product" class="img-thumbnail" style="height: 150px;">
                </div>

               
                <div class="mb-3">
                    <label asp-for="NewImage" class="form-label">Upload New Image (Optional)</label>
                    <input asp-for="NewImage" type="file" class="form-control" accept="image/*">
                    <span asp-validation-for="NewImage" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Product Name</label>
                    <input asp-for="Name" class="form-control">
                </div>
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label">Price (€)</label>
                        <input asp-for="Price" class="form-control" step="0.01">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Sku" class="form-label">SKU</label>
                        <input asp-for="Sku" class="form-control">
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-warning text-white">Update Changes</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Go Back</a>
                </div>
            </form>
        </div>
    </div>
</div>
@{
}
@{
	ViewData["Title"] = "Secure Payment";
}

<div class="container mt-5 text-center">
	<h2>Complete Your Payment</h2>
	<p class="text-muted">Please enter your payment details or scan the QR code to pay for Order <strong>#@ViewBag.OrderId</strong>.</p>

	<div class="card mx-auto shadow-sm mt-4 border-0" style="max-width: 450px; background-color: #f8f9fa;">
		<div class="card-body p-4">
			<h5 class="card-title mb-4">Credit Card Details</h5>

			<form asp-action="ProcessPayment" method="post">
				<input type="hidden" name="orderId" value="@ViewBag.OrderId" />

				<div class="mb-3 text-start">
					<label class="form-label fw-bold">Card Number</label>
					<input type="text" class="form-control" placeholder="1234 5678 9101 1121" required>
				</div>
				<div class="row mb-3 text-start">
					<div class="col">
						<label class="form-label fw-bold">Expiry Date</label>
						<input type="text" class="form-control" placeholder="MM/YY" required>
					</div>
					<div class="col">
						<label class="form-label fw-bold">CVV</label>
						<input type="text" class="form-control" placeholder="123" required>
					</div>
				</div>

				<hr class="my-4" />

				<p class="text-muted small fw-bold mb-2">Or pay with QR Code</p>
				<img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=PaymentForCampingOrder_@ViewBag.OrderId" alt="QR Code" class="mb-4 rounded" />

				<button type="submit" class="btn btn-success w-100 btn-lg">Confirm Payment</button>
			</form>
		</div>
	</div>
</div>
@{
}
@model Webshop.website.ViewModels.OrderCreateViewModel

@{
	ViewData["Title"] = "Secure Checkout";
	var cart = ViewBag.Cart as CartViewModel;
	var userName = ViewBag.UserName as string;
}

<div class="container mt-5">
	<div class="row">
		<div class="col-md-7 mb-4">
			<div class="card shadow-sm border-0">
				<div class="card-header bg-success text-white py-3">
					<h4 class="mb-0"><i class="bi bi-truck me-2"></i> Delivery Details</h4>
				</div>
				<div class="card-body p-4">
                    <h5 class="mb-4 text-muted">Customer: <span class="text-dark fw-bold">@userName</span></h5>
					<form asp-controller="Checkout" asp-action="Process" method="post">

						<div class="row mb-3">
							<div class="col-md-8">
								<label asp-for="Street" class="form-label">Street</label>
								<input asp-for="Street" class="form-control" placeholder="e.g. Main Street" required />
							</div>
							<div class="col-md-4">
								<label asp-for="HouseNumber" class="form-label">House Number</label>
								<input asp-for="HouseNumber" class="form-control" placeholder="e.g. 12A" required />
							</div>
						</div>

						<div class="row mb-3">
							<div class="col-md-4">
								<label asp-for="PostalCode" class="form-label">Postal Code</label>
								<input asp-for="PostalCode" class="form-control" placeholder="e.g. 1000" required />
							</div>
							<div class="col-md-8">
								<label asp-for="City" class="form-label">City</label>
								<input asp-for="City" class="form-control" placeholder="e.g. Brussels" required />
							</div>
						</div>

						<div class="mb-4">
							<label asp-for="Country" class="form-label">Country</label>
							<input asp-for="Country" class="form-control" placeholder="e.g. Belgium" required />
						</div>

						<div class="d-grid gap-2">
							<button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold">
								Place Order Now <i class="bi bi-check-circle ms-1"></i>
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    <h4 class="mb-0"><i class="bi bi-cart-check me-2"></i> Order Summary</h4>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (cart != null && cart.Items.Any())
                        {
                            foreach (var item in cart.Items)
                            {
                                <li class="list-group-item p-3">
                                    <div class="d-flex justify-content-between lh-sm mb-2">
                                        <div>
                                            <h6 class="my-0">@item.ProductName</h6>
                                            <small class="text-muted">€@item.UnitPrice.ToString("F2") / piece</small>
                                        </div>
                                        <span class="text-dark fw-bold">€@((item.Quantity * item.UnitPrice).ToString("F2"))</span>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between mt-2">
                                        <div class="btn-group btn-group-sm">
                                            <form asp-controller="Checkout" asp-action="UpdateQuantity" method="post" class="d-inline">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="change" value="-1" />
                                                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-dash"></i></button>
                                            </form>
                                            <span class="btn btn-outline-secondary disabled text-dark fw-bold px-3">@item.Quantity</span>
                                            <form asp-controller="Checkout" asp-action="UpdateQuantity" method="post" class="d-inline">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="change" value="1" />
                                                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-plus"></i></button>
                                            </form>
                                        </div>
                                        <form asp-controller="Checkout" asp-action="UpdateQuantity" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="change" value="-9999" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </li>
                            }
                            <li class="list-group-item d-flex justify-content-between p-3 bg-light">
                                <h5 class="mb-0">Total</h5>
                                <h5 class="mb-0 fw-bold text-success">€@cart.Items.Sum(i => i.Quantity * i.UnitPrice).ToString("F2")</h5>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
	</div>
</div>
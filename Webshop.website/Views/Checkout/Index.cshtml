@{
}
@model Webshop.website.ViewModels.OrderCreateViewModel

@{
	ViewData["Title"] = "Secure Checkout";
}

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-md-8">
			<div class="card shadow-sm border-0">
				<div class="card-header bg-success text-white py-3">
					<h4 class="mb-0"><i class="bi bi-truck me-2"></i> Delivery Details</h4>
				</div>
				<div class="card-body p-4">
					<form asp-controller="Checkout" asp-action="Process" method="post">

						<div class="row mb-3">
							<div class="col-md-8">
								<label asp-for="Street" class="form-label">Street</label>
								<input asp-for="Street" class="form-control" placeholder="e.g. Main Street" required />
							</div>
							<div class="col-md-4">
								<label asp-for="HouseNumber" class="form-label">House Number</label>
								<input asp-for="HouseNumber" class="form-control" placeholder="e.g. 12A" required />
							</div>
						</div>

						<div class="row mb-3">
							<div class="col-md-4">
								<label asp-for="PostalCode" class="form-label">Postal Code</label>
								<input asp-for="PostalCode" class="form-control" placeholder="e.g. 1000" required />
							</div>
							<div class="col-md-8">
								<label asp-for="City" class="form-label">City</label>
								<input asp-for="City" class="form-control" placeholder="e.g. Brussels" required />
							</div>
						</div>

						<div class="mb-4">
							<label asp-for="Country" class="form-label">Country</label>
							<input asp-for="Country" class="form-control" placeholder="e.g. Belgium" required />
						</div>

						<div class="d-grid gap-2">
							<button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold">
								Place Order Now <i class="bi bi-check-circle ms-1"></i>
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
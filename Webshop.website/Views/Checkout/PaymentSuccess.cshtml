@{
}
@model int
@{
	ViewData["Title"] = "Payment Successful";
}

<div class="container mt-5 text-center">
	<div class="mb-4">
		<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="#198754" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
			<path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
		</svg>
	</div>

	<h2 class="text-success">Payment Successful!</h2>
	<p class="text-muted fs-5 mt-3">Your payment for the camping gear has been processed securely.</p>
	<p class="text-muted">You will be redirected to the order confirmation page in a few seconds...</p>

	<div class="spinner-border text-success mt-4" role="status">
		<span class="visually-hidden">Loading...</span>
	</div>
</div>

<script>
	setTimeout(function() {
		window.location.href = '@Url.Action("Success", "Checkout", new { orderId = Model })';
	}, 3000);
</script>
@using Webshop.Application.Services.Contracts
@using Webshop.Application.Repositories
@using Webshop.Domain.Entities
@using Microsoft.AspNetCore.Hosting
@using System.IO

@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 bg-white shadow-sm rounded">
            <h2 class="text-center mb-4 text-warning">Edit Product (Blazor)</h2>

            @if (productToEdit == null)
            {
                <p><em>Loading...</em></p>
            }
            else
            {
                <EditForm Model="@productToEdit" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    <div class="mb-3 text-center">
                        <label class="d-block form-label">Current Product Image</label>
                        <img src="@productToEdit.ImageUrl" alt="Product" class="img-thumbnail" style="height: 150px;">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Upload New Image (Optional)</label>
                        <InputFile OnChange="HandleFileSelected" class="form-control" accept="image/*" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Product Name</label>
                        <InputText @bind-Value="productToEdit.Name" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <InputSelect @bind-Value="productToEdit.CategoryId" class="form-select">
                            <option value="0">-- Choose Category --</option>
                            @if (categories != null)
                            {
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryId">@cat.Name</option>
                                }
                            }
                        </InputSelect>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Price (€)</label>
                            <InputNumber @bind-Value="productToEdit.Price" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">SKU / Code</label>
                            <InputText @bind-Value="productToEdit.Sku" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Full Description</label>
                        <InputTextArea @bind-Value="productToEdit.Description" class="form-control" rows="3" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Or enter Image URL</label>
                        <InputText @bind-Value="productToEdit.ImageUrl" class="form-control" />
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-warning text-white">Update Changes</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick='() => NavigationManager.NavigateTo("/Product", forceLoad: true)'>Cancel</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int ProductId { get; set; }

    private Product? productToEdit;
    private IEnumerable<Category> categories = new List<Category>();
    private IBrowserFile? newImageFile;

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryService.GetAll();

        var result = await ProductService.GetById(ProductId);
        if (result.Succeeded && result.Data != null)
        {
            productToEdit = result.Data;
            if (string.IsNullOrWhiteSpace(productToEdit.ImageUrl))
            {
                productToEdit.ImageUrl = "/images/default.jpg";
            }
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        newImageFile = e.File;
    }

    private async Task HandleValidSubmit()
    {
        if (productToEdit != null)
        {
            try
            {
                // If a new file was uploaded via Blazor InputFile, save it here
                if (newImageFile != null)
                {
                    string fileName = Guid.NewGuid().ToString() + Path.GetExtension(newImageFile.Name);
                    string filePath = Path.Combine(Environment.WebRootPath, "images", fileName);

                    // Ensure images directory exists
                    Directory.CreateDirectory(Path.Combine(Environment.WebRootPath, "images"));

                    using (var stream = new FileStream(filePath, FileMode.Create))
                    {
                        // Limit size to avoid memory issues, e.g., max 5MB
                        long maxFileSize = 1024 * 1024 * 5; 
                        await newImageFile.OpenReadStream(maxFileSize).CopyToAsync(stream);
                    }

                    productToEdit.ImageUrl = "/images/" + fileName;
                }

                // Call ProductService.Update with null for IFormFile, passing new ImageUrl
                var result = await ProductService.Update(productToEdit, null, productToEdit.ImageUrl);
                
                if (result.Succeeded)
                {
                    NavigationManager.NavigateTo("/Product", forceLoad: true);
                }
                else
                {
                    Console.WriteLine("Update failed: " + string.Join(", ", result.Errors));
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"ERROR (Update): {ex.Message}");
            }
        }
    }
}

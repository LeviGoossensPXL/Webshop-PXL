@using Webshop.Application.Services.Contracts
@using Webshop.Application.Repositories
@using Webshop.Domain.Entities
@using Microsoft.AspNetCore.Hosting
@using System.IO
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations

@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment
@inject IHttpClientFactory HttpClientFactory

<div class="container mt-4">
	<div class="row justify-content-center">
		<div class="col-md-6 border p-4 bg-white shadow-sm rounded">
			<h2 class="text-center mb-4 text-warning">Edit Product & Stock (Blazor)</h2>

			@if (editModel == null)
			{
				<p><em>Loading product data...</em></p>
			}
			else
			{
				@if (!string.IsNullOrEmpty(errorMessage))
				{
					<div class="alert alert-danger" role="alert">
						@errorMessage
					</div>
				}

				<EditForm Model="@editModel" OnValidSubmit="HandleValidSubmit">
					<DataAnnotationsValidator />

					<div class="mb-3 text-center">
						<label class="d-block form-label">Current Product Image</label>
						<img src="@editModel.ImageUrl" alt="Product" class="img-thumbnail" style="height: 150px;">
					</div>

					<div class="mb-3">
						<label class="form-label">Upload New Image (Optional)</label>
						<InputFile OnChange="HandleFileSelected" class="form-control" accept="image/*" />
					</div>

					<div class="mb-3">
						<label class="form-label">Product Name</label>
						<InputText @bind-Value="editModel.Name" class="form-control" />
						<ValidationMessage For="@(() => editModel.Name)" class="text-danger" />
					</div>

					<div class="mb-3">
						<label class="form-label">Category</label>
						<InputSelect @bind-Value="editModel.CategoryId" class="form-select">
							<option value="0">-- Choose Category --</option>
							@if (categories != null)
							{
								@foreach (var cat in categories)
								{
									<option value="@cat.CategoryId">@cat.Name</option>
								}
							}
						</InputSelect>
						<ValidationMessage For="@(() => editModel.CategoryId)" class="text-danger" />
					</div>

					<div class="row">
						<div class="col-md-6 mb-3">
							<label class="form-label">Price (€)</label>
							<InputNumber @bind-Value="editModel.Price" class="form-control" />
							<ValidationMessage For="@(() => editModel.Price)" class="text-danger" />
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label">SKU / Code</label>
							<InputText @bind-Value="editModel.Sku" class="form-control" />
							<ValidationMessage For="@(() => editModel.Sku)" class="text-danger" />
						</div>
					</div>

					<div class="mb-3">
						<label class="form-label">Full Description</label>
						<InputTextArea @bind-Value="editModel.Description" class="form-control" rows="3" />
						<ValidationMessage For="@(() => editModel.Description)" class="text-danger" />
					</div>

					<div class="mb-3">
						<label class="form-label">Or enter Image URL</label>
						<InputText @bind-Value="editModel.ImageUrl" class="form-control" />
					</div>

					<hr class="my-3" />
					<h5 class="text-muted mb-3">📦 Update Stock Information</h5>

					<div class="row">
						<div class="col-md-6 mb-3">
							<label class="form-label">Stock Quantity</label>
							<InputNumber @bind-Value="editModel.Quantity" class="form-control" />
							<ValidationMessage For="@(() => editModel.Quantity)" class="text-danger" />
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label">Warehouse Location</label>
							<InputText @bind-Value="editModel.WarehouseLocation" class="form-control" />
							<ValidationMessage For="@(() => editModel.WarehouseLocation)" class="text-danger" />
						</div>
					</div>

					<div class="d-grid gap-2 mt-4">
						<button type="submit" class="btn btn-warning text-white">Update Changes</button>
						<button type="button" class="btn btn-outline-secondary" @onclick='() => NavigationManager.NavigateTo("/Product", forceLoad: true)'>Cancel</button>
					</div>
				</EditForm>
			}
		</div>
	</div>
</div>

@code {
	[Parameter] public int ProductId { get; set; }

	private ProductFormModel editModel;
	private IEnumerable<Category> categories = new List<Category>();
	private IBrowserFile? newImageFile;
	private string errorMessage = string.Empty;

	public class ProductFormModel
	{
		[Required(ErrorMessage = "The product name is required.")]
		public string Name { get; set; }

		[Required(ErrorMessage = "An explanation is required.")]
		[MinLength(10, ErrorMessage = "Too short. Minimum 10 characters.")]
		public string Description { get; set; }

		[Required(ErrorMessage = "The price is required.")]
		[Range(0.1, 10000, ErrorMessage = "Price must be greater than 0.")]
		public decimal Price { get; set; }

		[Required(ErrorMessage = "The SKU is required.")]
		public string Sku { get; set; }

		[Range(1, int.MaxValue, ErrorMessage = "Please select a category.")]
		public int CategoryId { get; set; }

		public string? ImageUrl { get; set; }

		[Required(ErrorMessage = "Quantity is required.")]
		[Range(0, 10000, ErrorMessage = "Quantity cannot be negative.")]
		public int Quantity { get; set; }

		[Required(ErrorMessage = "Warehouse location is required.")]
		public string WarehouseLocation { get; set; } = "Default Warehouse";
	}

	protected override async Task OnInitializedAsync()
	{
		categories = await CategoryService.GetAll();

		var result = await ProductService.GetById(ProductId);
		if (result.Succeeded && result.Data != null)
		{
			var p = result.Data;

			// Map product data to form model
			editModel = new ProductFormModel
			{
				Name = p.Name,
				Description = p.Description,
				Price = p.Price,
				Sku = p.Sku,
				CategoryId = p.CategoryId,
				ImageUrl = string.IsNullOrWhiteSpace(p.ImageUrl) ? "/images/default.jpg" : p.ImageUrl
			};

			// Fetch current stock info from API
			try
			{
				var client = HttpClientFactory.CreateClient("StockApi");
				var stockItem = await client.GetFromJsonAsync<StockItem>($"/StockItem/product/{ProductId}");
				if (stockItem != null)
				{
					editModel.Quantity = stockItem.Quantity;
					editModel.WarehouseLocation = stockItem.WarehouseLocation;
				}
			}
			catch { /* If stock record doesn't exist yet, use defaults */ }
		}
	}

	private void HandleFileSelected(InputFileChangeEventArgs e)
	{
		newImageFile = e.File;
	}

	private async Task HandleValidSubmit()
	{
		try
		{
			// 1. Handle image upload if a new file is chosen
			if (newImageFile != null)
			{
				string fileName = Guid.NewGuid().ToString() + Path.GetExtension(newImageFile.Name);
				string filePath = Path.Combine(Environment.WebRootPath, "images", fileName);
				Directory.CreateDirectory(Path.Combine(Environment.WebRootPath, "images"));

				using (var stream = new FileStream(filePath, FileMode.Create))
				{
					await newImageFile.OpenReadStream(1024 * 1024 * 5).CopyToAsync(stream);
				}
				editModel.ImageUrl = "/images/" + fileName;
			}

			// 2. Prepare Product entity for update
			var productToUpdate = new Product
			{
				ProductId = this.ProductId,
				Name = editModel.Name,
				Description = editModel.Description,
				Price = editModel.Price,
				Sku = editModel.Sku,
				CategoryId = editModel.CategoryId,
				ImageUrl = editModel.ImageUrl
			};

			// 3. Update Webshop DB
			var result = await ProductService.Update(productToUpdate, null, editModel.ImageUrl);

			if (result.Succeeded)
			{
				// 4. Update Stock API
				var stockUpdate = new StockItem
				{
					ProductId = this.ProductId,
					Quantity = editModel.Quantity,
					Sku = editModel.Sku,
					WarehouseLocation = editModel.WarehouseLocation
				};

				var client = HttpClientFactory.CreateClient("StockApi");
				var response = await client.PutAsJsonAsync($"/StockItem/product/{this.ProductId}", stockUpdate);
				if (!response.IsSuccessStatusCode)
				{
					var errorContent = await response.Content.ReadAsStringAsync();
					errorMessage = $"PUT Error ({response.StatusCode}): {errorContent}";
					Console.WriteLine(errorMessage);
					// Try POST fallback
					var postResponse = await client.PostAsJsonAsync("/StockItem", stockUpdate);
					if (!postResponse.IsSuccessStatusCode)
					{
						errorMessage += $" | POST Error ({postResponse.StatusCode}): {await postResponse.Content.ReadAsStringAsync()}";
						return; // Don't redirect if both fail
					}
				}

				NavigationManager.NavigateTo("/Product", forceLoad: true);
			}
		}
		catch (Exception ex)
		{
			errorMessage = $"ERROR (Submit): {ex.Message}";
			Console.WriteLine(errorMessage);
		}
	}
}